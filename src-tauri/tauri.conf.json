{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peck",
  "version": "0.6.0",
  "identifier": "com.personalclistudio.peck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Peck",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 30,
          "y": 47
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/j2.icns",
      "icons/j2.png"
    ],
    "resources": [
      "defaults/**/*",
      "integrations/*.py"
    ],
    "macOS": {
      "signingIdentity": "Peck Self-Signed"
    }
  }
}
