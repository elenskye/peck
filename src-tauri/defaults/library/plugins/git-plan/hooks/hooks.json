{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/handoff.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "peck",
            "ask": "提交说明只写一行 v<版本>: <description>：版本是这个仓库现在在做的版本号，description 用小写英文、简约概括（比如 fix some problems、minor improvement）。不要署名。",
            "run": "git_commit"
          }
        ]
      }
    ]
  }
}
